# Python
*__pycache__*
*.egg-info
*.py[cod]
*.sh.e*
*.sh.o*

venv/
runs/
mlruns/
outputs/
scripts/
data/jetclass/
data/JetClass/
data/toptagxl/
*~
*.hdf5
*.npy
*.npz
*.ipynb_checkpoint*

# utils/find_lr.py outputs. The directory is the current default; the flat pattern still
# covers older checkouts and any custom `+lr_find.output=` path (.npz is covered by *.npz).
lr_finder/
lr_finder_*.png



# local sbatch copies (root only -- docs/oscar-train.sbatch stays tracked): the working
# copy carries YOUR partition/account (-p/-A), which must never be committed to a public repo
/*.sbatch

# SLURM job logs: train.sbatch writes logs/%x-%j.out; also catch any stray root-level
# .out from scripts that forget the logs/ prefix (early download jobs did)
logs/
*.out
