# pytest
.coverage
.pytest
.pytest_cache

# Python
*__pycache__*
*.egg-info
*.py[cod]
*.sh.e*
*.sh.o*

venv/
# no trailing slash: docs/OSCAR.md turns these three into SYMLINKS into ~/scratch, and a
# trailing-slash pattern matches directories ONLY -- so `runs/` left the symlink untracked
# and `git add -A` would have committed a link into someone's personal scratch path.
runs
mlruns/
outputs/
scripts/
data/jetclass/
data/JetClass
data/toptagxl
*~
*.hdf5
*.npy
*.npz
*.ipynb_checkpoint*

# utils/find_lr.py outputs. The directory is the current default; the flat pattern still
# covers older checkouts and any custom `+lr_find.output=` path (.npz is covered by *.npz).
lr_finder/
lr_finder_*.png


# other utils, plotters and more
*.pdf
# local sbatch copies (root only -- docs/oscar-train.sbatch stays tracked): the working
# copy carries YOUR partition/account (-p/-A), which must never be committed to a public repo
/*.sbatch

# SLURM job logs: train.sbatch writes logs/%x-%j.out; also catch any stray root-level
# .out from scripts that forget the logs/ prefix (early download jobs did)
logs/
*.out

# beta-PERF's append log: a RUNTIME artifact, not a record. utils/bperf.py appends a
# table on every run; the runbook's flow is to paste the table into
# docs/cgenn-compile.md and let this file stay local (cleanup.md step 6).
bperf_results.md

# profiler traces from utils/profile_sync.py (per-session artifacts, read in chrome://tracing)
profiles/
